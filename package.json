{
  "name": "opencode-plugin-gotify",
  "version": "2.0.0",
  "description": "An OpenCode V2 plugin to send Gotify notifications for sessions and user input",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dParikesit/opencode-plugin-gotify.git"
  },
  "bugs": {
    "url": "https://github.com/dParikesit/opencode-plugin-gotify/issues"
  },
  "homepage": "https://github.com/dParikesit/opencode-plugin-gotify#readme",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepare": "npm run build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.mjs\"",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.3"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0",
    "prettier": "^3.0.0"
  }
}
